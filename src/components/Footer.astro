---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center text-white font-bold text-sm">
            M
          </div>
          <span class="text-lg font-serif font-bold">MyBlog</span>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 max-w-sm">
          记录生活，分享思考。一个关于技术、生活与成长的个人博客。
        </p>
        <div class="flex items-center gap-4 mt-4">
          <a
            href="https://github.com/vectrol"
            target="_blank"
            rel="noopener"
            class="p-2 bg-gray-200 dark:bg-gray-800 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener"
            class="p-2 bg-gray-200 dark:bg-gray-800 rounded-lg hover:bg-orange-100 dark:hover:bg-orange-900/30 transition-colors"
            aria-label="RSS 订阅"
          >
            <svg class="w-5 h-5 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.37 20 6.18 20 4.99 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4">导航</h4>
        <ul class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">首页</a></li>
          <li><a href="/categories" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">分类</a></li>
          <li><a href="/archive" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">归档</a></li>
          <li><a href="/about" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">关于</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4">订阅</h4>
        <ul class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/rss.xml" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">RSS 订阅</a></li>
          <li><a href="mailto:your@email.com" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">邮件联系</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-500">
      <p>&copy; {currentYear} MyBlog. All rights reserved.</p>
      <p class="flex items-center gap-1">
        使用 <a href="https://astro.build" target="_blank" rel="noopener" class="text-brand-600 dark:text-brand-400 hover:underline">Astro</a> 构建
      </p>
    </div>
  </div>
</footer>
