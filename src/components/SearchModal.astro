---
---

<div id="search-modal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="search-overlay"></div>
  
  <div class="relative max-w-2xl mx-auto mt-20 mx-4">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl overflow-hidden">
      <div class="flex items-center px-4 border-b border-gray-200 dark:border-gray-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="搜索文章..."
          class="flex-1 px-4 py-4 bg-transparent text-lg outline-none dark:text-white placeholder-gray-400"
          autocomplete="off"
        />
        <kbd class="hidden sm:inline-flex px-2 py-1 text-xs font-mono text-gray-400 bg-gray-100 dark:bg-gray-800 rounded">
          ESC
        </kbd>
      </div>

      <div id="search-results" class="max-h-96 overflow-y-auto p-2">
        <p class="text-center text-gray-500 dark:text-gray-400 py-8 text-sm">
          输入关键词开始搜索...
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  let fuse: Fuse<any> | null = null;
  let searchData: any[] = [];

  async function loadSearchData() {
    try {
      const res = await fetch('/search.json');
      searchData = await res.json();
      fuse = new Fuse(searchData, {
        keys: ['title', 'description', 'tags', 'category'],
        threshold: 0.3,
      });
    } catch {
      console.error('Failed to load search data');
    }
  }

  function openSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    modal?.classList.remove('hidden');
    input?.focus();
    document.body.style.overflow = 'hidden';
    if (!fuse) loadSearchData();
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    modal?.classList.add('hidden');
    if (input) input.value = '';
    document.body.style.overflow = '';
    renderResults(null);
  }

  function renderResults(results: any[] | null) {
    const container = document.getElementById('search-results');
    if (!container) return;

    if (!results) {
      container.innerHTML = `
        <p class="text-center text-gray-500 dark:text-gray-400 py-8 text-sm">
          输入关键词开始搜索...
        </p>
      `;
      return;
    }

    if (results.length === 0) {
      container.innerHTML = `
        <p class="text-center text-gray-500 dark:text-gray-400 py-8 text-sm">
          没有找到相关文章
        </p>
      `;
      return;
    }

    container.innerHTML = results
      .map(({ item }) => `
        <a href="/posts/${item.slug}" class="block p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          <h3 class="font-medium dark:text-white">${item.title}</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-1">${item.description || ''}</p>
          <div class="flex items-center gap-2 mt-2 text-xs text-gray-400">
            <time>${new Date(item.pubDate).toLocaleDateString('zh-CN')}</time>
            ${item.category ? `<span class="px-1.5 py-0.5 bg-brand-50 dark:bg-brand-950 text-brand-600 dark:text-brand-400 rounded">${item.category}</span>` : ''}
          </div>
        </a>
      `)
      .join('');
  }

  document.getElementById('search-btn')?.addEventListener('click', openSearch);
  document.getElementById('search-overlay')?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });

  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const query = target.value.trim();
    if (!query || !fuse) {
      renderResults(null);
      return;
    }
    const results = fuse.search(query);
    renderResults(results);
  });
</script>
