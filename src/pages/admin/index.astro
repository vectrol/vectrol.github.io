---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="管理后台 - MyBlog">
  <div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-950 px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-6">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center text-white font-bold shadow-lg shadow-brand-500/25">
            M
          </div>
          <span class="text-2xl font-serif font-bold">MyBlog</span>
        </a>
        <h1 class="text-2xl font-serif font-bold">管理后台</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2">请输入密码登录</p>
      </div>

      <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-8 border border-gray-200 dark:border-gray-800">
        <form id="login-form" class="space-y-6">
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              密码
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition-all"
              placeholder="输入访问密码"
            />
          </div>

          <div id="error-message" class="hidden text-sm text-red-500 bg-red-50 dark:bg-red-900/20 p-3 rounded-lg">
            密码错误，请重试
          </div>

          <button
            type="submit"
            class="w-full py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-medium hover:shadow-lg hover:shadow-gray-900/25 dark:hover:shadow-white/25 transition-all duration-300 hover:scale-[1.02]"
          >
            登录
          </button>
        </form>
      </div>

      <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6">
        <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
          ← 返回首页
        </a>
      </p>
    </div>
  </div>

  <script>
    const ADMIN_PASSWORD = 'blog2024';

    // 检查是否已登录
    if (localStorage.getItem('admin_token')) {
      window.location.href = '/admin/dashboard';
    }

    document.getElementById('login-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      
      if (password === ADMIN_PASSWORD) {
        localStorage.setItem('admin_token', 'authenticated');
        window.location.href = '/admin/dashboard';
      } else {
        document.getElementById('error-message')?.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
