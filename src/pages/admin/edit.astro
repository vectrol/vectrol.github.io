---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="编辑文章 - MyBlog">
  <div class="min-h-screen bg-gray-50 dark:bg-gray-950">
    <header class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            返回
          </a>
          <span class="text-gray-300 dark:text-gray-600">|</span>
          <span class="text-sm text-gray-500 dark:text-gray-400">编辑文章</span>
        </div>

        <div class="flex items-center gap-3">
          <button
            id="save-draft-btn"
            class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg text-sm font-medium transition-colors"
          >
            保存草稿
          </button>
          <button
            id="publish-btn"
            class="px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors"
          >
            更新文章
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- 左侧：元数据表单 -->
        <div class="lg:col-span-1 space-y-4">
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6">
            <h3 class="font-serif font-bold mb-4">文章设置</h3>
            
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">标题 *</label>
                <input
                  type="text"
                  id="title"
                  required
                  class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none"
                  placeholder="文章标题"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">描述</label>
                <textarea
                  id="description"
                  rows="2"
                  class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none resize-none"
                  placeholder="文章摘要"
                ></textarea>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">分类</label>
                  <input
                    type="text"
                    id="category"
                    class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none"
                    placeholder="如：技术、生活"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">发布日期</label>
                  <input
                    type="date"
                    id="pubDate"
                    class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">标签（逗号分隔）</label>
                <input
                  type="text"
                  id="tags"
                  class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none"
                  placeholder="如：JavaScript, 教程, 前端"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">封面图 URL</label>
                <input
                  type="url"
                  id="heroImage"
                  class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none"
                  placeholder="https://..."
                />
              </div>

              <div class="flex items-center gap-3">
                <input
                  type="checkbox"
                  id="featured"
                  class="w-4 h-4 text-brand-600 bg-gray-100 border-gray-300 rounded focus:ring-brand-500"
                />
                <label for="featured" class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  设为精选文章
                </label>
              </div>
            </div>
          </div>

          <!-- GitHub Token 设置 -->
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6">
            <h3 class="font-serif font-bold mb-4">GitHub Token</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
              需要 Token 才能发布文章。在 <a href="https://github.com/settings/tokens" target="_blank" class="text-brand-600 hover:underline">GitHub Settings</a> 创建。
            </p>
            <input
              type="password"
              id="github-token"
              class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-brand-500 outline-none text-sm"
              placeholder="ghp_xxxxxxxxxxxx"
            />
            <p class="text-xs text-gray-400 mt-2">Token 需要 repo 权限，仅存储在本地浏览器。</p>
          </div>
        </div>

        <!-- 右侧：Markdown 编辑器 -->
        <div class="lg:col-span-2">
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 overflow-hidden h-[calc(100vh-10rem)]">
            <div id="editor-container" class="h-full flex flex-col">
              <!-- 编辑器工具栏 -->
              <div class="flex items-center gap-2 px-4 py-2 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50">
                <button onclick="insertMarkdown('**', '**')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="加粗">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6z M6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('*', '*')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="斜体">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4h4m-2 0v16m-4 0h8" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('`', '`')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="行内代码">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('```\n', '\n```')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="代码块">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </button>
                <div class="w-px h-5 bg-gray-300 dark:bg-gray-600"></div>
                <button onclick="insertMarkdown('## ', '')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="标题">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('- ', '')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="列表">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('> ', '')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="引用">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('[链接文字](', ')')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="链接">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                </button>
                <button onclick="insertMarkdown('![图片](', ')')" class="p-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors" title="图片">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </button>
              </div>

              <!-- 编辑器内容区 -->
              <div class="flex-1 flex overflow-hidden">
                <div class="flex-1 flex flex-col border-r border-gray-200 dark:border-gray-800">
                  <div class="px-4 py-1.5 text-xs font-medium text-gray-500 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-200 dark:border-gray-800">
                    Markdown
                  </div>
                  <textarea
                    id="editor"
                    class="flex-1 p-4 font-mono text-sm bg-transparent outline-none resize-none"
                    placeholder="开始写作..."
                  ></textarea>
                </div>

                <div class="flex-1 flex flex-col">
                  <div class="px-4 py-1.5 text-xs font-medium text-gray-500 bg-gray-50 dark:bg-gray-800/50 border-b border-gray-200 dark:border-gray-800">
                    预览
                  </div>
                  <div id="preview" class="flex-1 p-4 overflow-auto prose prose-sm dark:prose-invert max-w-none">
                    <p class="text-gray-400">在左侧输入 Markdown 内容...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    if (!localStorage.getItem('admin_token')) {
      window.location.href = '/admin';
    }

    const OWNER = 'vectrol';
    const REPO = 'vectrol.github.io';
    const POSTS_PATH = 'src/content/posts';

    let currentSha = '';
    let currentFileName = '';

    // Load token from localStorage
    const savedToken = localStorage.getItem('github_token');
    if (savedToken) {
      (document.getElementById('github-token') as HTMLInputElement).value = savedToken;
    }

    document.getElementById('github-token')?.addEventListener('change', (e) => {
      localStorage.setItem('github_token', (e.target as HTMLInputElement).value);
    });

    // Get filename from URL params
    const params = new URLSearchParams(window.location.search);
    const fileName = params.get('file');

    if (!fileName) {
      alert('缺少文件参数');
      window.location.href = '/admin/dashboard';
    }

    currentFileName = fileName!;

    // Parse frontmatter
    function parseFrontmatter(raw: string): { meta: Record<string, string>; body: string } {
      const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
      if (!match) return { meta: {}, body: raw };

      const meta: Record<string, string> = {};
      const lines = match[1].split('\n');

      for (const line of lines) {
        const idx = line.indexOf(':');
        if (idx === -1) continue;
        const key = line.slice(0, idx).trim();
        let val = line.slice(idx + 1).trim();
        if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
          val = val.slice(1, -1);
        }
        if (val.startsWith('[')) {
          val = val.replace(/[\[\]"]/g, '');
        }
        meta[key] = val;
      }

      return { meta, body: match[2].replace(/^\n+/, '') };
    }

    // Fill form from meta
    function fillForm(meta: Record<string, string>) {
      if (meta.title) (document.getElementById('title') as HTMLInputElement).value = meta.title;
      if (meta.description) (document.getElementById('description') as HTMLTextAreaElement).value = meta.description;
      if (meta.category) (document.getElementById('category') as HTMLInputElement).value = meta.category;
      if (meta.pubDate) (document.getElementById('pubDate') as HTMLInputElement).value = meta.pubDate;
      if (meta.tags) (document.getElementById('tags') as HTMLInputElement).value = meta.tags;
      if (meta.heroImage) (document.getElementById('heroImage') as HTMLInputElement).value = meta.heroImage;
      if (meta.featured === 'true') (document.getElementById('featured') as HTMLInputElement).checked = true;
    }

    // Load article from GitHub
    async function loadArticle() {
      const token = localStorage.getItem('github_token');
      const url = `https://api.github.com/repos/${OWNER}/${REPO}/contents/${POSTS_PATH}/${currentFileName}`;

      const headers: Record<string, string> = { Accept: 'application/vnd.github.v3+json' };
      if (token) headers.Authorization = `Bearer ${token}`;

      try {
        const res = await fetch(url, { headers });
        if (!res.ok) throw new Error('Failed to load article');

        const data = await res.json();
        currentSha = data.sha;

        const content = decodeURIComponent(escape(atob(data.content)));
        const { meta, body } = parseFrontmatter(content);

        fillForm(meta);
        (document.getElementById('editor') as HTMLTextAreaElement).value = body;
        updatePreview();
      } catch (e) {
        alert('加载文章失败：' + e);
        window.location.href = '/admin/dashboard';
      }
    }

    // Markdown toolbar
    (window as any).insertMarkdown = function(before: string, after: string) {
      const textarea = document.getElementById('editor') as HTMLTextAreaElement;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selected = textarea.value.substring(start, end);
      const replacement = before + (selected || '文本') + after;

      textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
      textarea.focus();
      textarea.selectionStart = start + before.length;
      textarea.selectionEnd = start + before.length + (selected || '文本').length;

      updatePreview();
    };

    // Preview
    function updatePreview() {
      const content = (document.getElementById('editor') as HTMLTextAreaElement).value;
      const preview = document.getElementById('preview')!;

      if (!content.trim()) {
        preview.innerHTML = '<p class="text-gray-400">在左侧输入 Markdown 内容...</p>';
        return;
      }

      let html = content
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        .replace(/\*\*\*(.*?)\*\*\*/gim, '<strong><em>$1</em></strong>')
        .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/gim, '<em>$1</em>')
        .replace(/```(\w+)?\n([\s\S]*?)```/gim, '<pre><code class="language-$1">$2</code></pre>')
        .replace(/`(.*?)`/gim, '<code>$1</code>')
        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
        .replace(/^\- (.*$)/gim, '<li>$1</li>')
        .replace(/^(\d+)\. (.*$)/gim, '<li>$2</li>')
        .replace(/!\[(.*?)\]\((.*?)\)/gim, '<img src="$2" alt="$1" />')
        .replace(/\[(.*?)\]\((.*?)\)/gim, '<a href="$2">$1</a>')
        .replace(/\n/gim, '<br>');

      preview.innerHTML = html;
    }

    document.getElementById('editor')?.addEventListener('input', updatePreview);

    // Generate frontmatter
    function generateFrontmatter(draft: boolean): string {
      const title = (document.getElementById('title') as HTMLInputElement).value;
      const description = (document.getElementById('description') as HTMLTextAreaElement).value;
      const category = (document.getElementById('category') as HTMLInputElement).value;
      const pubDate = (document.getElementById('pubDate') as HTMLInputElement).value;
      const tags = (document.getElementById('tags') as HTMLInputElement).value
        .split(',').map(t => t.trim()).filter(Boolean);
      const heroImage = (document.getElementById('heroImage') as HTMLInputElement).value;
      const featured = (document.getElementById('featured') as HTMLInputElement).checked;

      let fm = `---\ntitle: "${title}"\n`;
      if (description) fm += `description: "${description}"\n`;
      fm += `pubDate: ${pubDate}\n`;
      if (heroImage) fm += `heroImage: "${heroImage}"\n`;
      if (tags.length > 0) fm += `tags: [${tags.map(t => `"${t}"`).join(', ')}]\n`;
      if (category) fm += `category: "${category}"\n`;
      fm += `featured: ${featured}\ndraft: ${draft}\n---\n\n`;
      return fm;
    }

    // Save
    async function saveArticle(draft: boolean) {
      const token = localStorage.getItem('github_token');
      if (!token) { alert('请先设置 GitHub Token'); return; }

      const title = (document.getElementById('title') as HTMLInputElement).value;
      if (!title) { alert('请输入文章标题'); return; }

      const content = generateFrontmatter(draft) + (document.getElementById('editor') as HTMLTextAreaElement).value;
      const encodedContent = btoa(unescape(encodeURIComponent(content)));

      const url = `https://api.github.com/repos/${OWNER}/${REPO}/contents/${POSTS_PATH}/${currentFileName}`;

      const body: any = {
        message: `[Admin] ${draft ? '保存草稿' : '更新'}《${title}》`,
        content: encodedContent,
        sha: currentSha,
      };

      try {
        const res = await fetch(url, {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        });

        if (res.ok) {
          const data = await res.json();
          currentSha = data.content.sha;
          alert(draft ? '草稿已保存！' : '文章已更新！构建完成后即可访问。');
        } else {
          const err = await res.json();
          alert('保存失败：' + (err.message || '未知错误'));
        }
      } catch (e) {
        alert('保存失败：' + e);
      }
    }

    document.getElementById('save-draft-btn')?.addEventListener('click', () => saveArticle(true));
    document.getElementById('publish-btn')?.addEventListener('click', () => saveArticle(false));

    loadArticle();
  </script>
</BaseLayout>
