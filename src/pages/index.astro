---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchModal from '../components/SearchModal.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = posts.filter((post) => post.data.featured);
const recentPosts = posts.slice(0, 6);
---

<BaseLayout title="MyBlog - 记录生活与思考">
  <Header />
  <SearchModal />

  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <!-- 背景装饰 -->
      <div class="absolute inset-0 bg-gradient-to-br from-gray-50 via-white to-brand-50 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950"></div>
      <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-[0.03] dark:opacity-[0.05]"></div>
      
      <!-- 浮动装饰元素 -->
      <div class="absolute top-20 left-10 w-72 h-72 bg-brand-300/20 dark:bg-brand-500/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-300/20 dark:bg-purple-500/10 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-36 relative">
        <div class="text-center">
          <!-- 头像 -->
          <div class="mb-8 animate-fade-in">
            <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-brand-400 to-brand-600 p-1 shadow-lg shadow-brand-500/25">
              <div class="w-full h-full rounded-full bg-white dark:bg-gray-900 flex items-center justify-center">
                <span class="text-4xl">👨‍💻</span>
              </div>
            </div>
          </div>

          <!-- 标题 -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold mb-6 animate-fade-in-up">
            <span class="bg-gradient-to-r from-gray-900 via-gray-700 to-gray-900 dark:from-white dark:via-gray-200 dark:to-white bg-clip-text text-transparent bg-[length:200%_auto] animate-[gradient_3s_linear_infinite]">
              记录生活与思考
            </span>
          </h1>

          <!-- 副标题 -->
          <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10 animate-fade-in-up-delay-1 leading-relaxed">
            这里是我的个人空间，记录着技术探索、生活感悟和成长足迹。<br class="hidden sm:block" />
            希望这些文字能给你带来一些启发。
          </p>

          <!-- 按钮 -->
          <div class="flex items-center justify-center gap-4 animate-fade-in-up-delay-2">
            <a href="/categories" class="group px-8 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-full font-medium hover:shadow-lg hover:shadow-gray-900/25 dark:hover:shadow-white/25 transition-all duration-300 hover:scale-105">
              浏览文章
              <span class="inline-block ml-1 group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <a href="/about" class="px-8 py-3.5 border border-gray-300 dark:border-gray-700 rounded-full font-medium hover:bg-gray-50 dark:hover:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-600 transition-all duration-300">
              关于我
            </a>
          </div>

          <!-- 统计数据 -->
          <div class="flex items-center justify-center gap-8 mt-12 animate-fade-in-up-delay-3 text-sm text-gray-500 dark:text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>{posts.length} 篇文章</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <span>{new Set(posts.flatMap(p => p.data.tags)).size} 个标签</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 底部渐变 -->
      <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white dark:from-gray-950 to-transparent"></div>
    </section>

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="flex items-center gap-3 mb-10">
          <div class="w-1 h-8 bg-gradient-to-b from-brand-500 to-brand-600 rounded-full"></div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold">精选文章</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {featuredPosts.map((post, i) => (
            <div class:list={['animate-fade-in-up', `animate-fade-in-up-delay-${i + 1}`]}>
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                heroImage={post.data.heroImage}
                slug={post.id}
                tags={post.data.tags}
                category={post.data.category}
                featured={true}
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Recent Posts -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-3">
          <div class="w-1 h-8 bg-gradient-to-b from-brand-500 to-brand-600 rounded-full"></div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold">最新文章</h2>
        </div>
        <a href="/categories" class="text-sm text-gray-500 hover:text-brand-600 dark:text-gray-400 dark:hover:text-brand-400 transition-colors flex items-center gap-1">
          查看全部
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post, i) => (
          <div class:list={['animate-fade-in-up', i < 3 ? `animate-fade-in-up-delay-${i + 1}` : '']}>
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              heroImage={post.data.heroImage}
              slug={post.id}
              tags={post.data.tags}
              category={post.data.category}
            />
          </div>
        ))}
      </div>
    </section>

    <!-- 订阅区域 -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="relative overflow-hidden bg-gradient-to-r from-brand-600 to-brand-700 rounded-3xl p-8 sm:p-12 text-white">
        <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-10"></div>
        <div class="relative flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-2xl font-serif font-bold mb-2">订阅更新</h3>
            <p class="text-brand-100">获取最新文章推送，不错过任何精彩内容。</p>
          </div>
          <div class="flex w-full sm:w-auto gap-2">
            <input
              type="email"
              placeholder="输入邮箱地址"
              class="flex-1 sm:w-64 px-4 py-3 bg-white/10 border border-white/20 rounded-xl placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/50 backdrop-blur-sm"
            />
            <button class="px-6 py-3 bg-white text-brand-600 rounded-xl font-medium hover:bg-brand-50 transition-colors whitespace-nowrap">
              订阅
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ThemeToggle />
</BaseLayout>

<style>
  @keyframes gradient {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
</style>
